    "encoding": "utf-8",
    "ua": "mobile",
    "searchable": true,
    "discoverable": false,
    "search": {
      "method": "post",
      "url": "{host}/novelsearch/search/result.html",
      "body": "searchword={kw}",
      "ua": "mobile",
      "list": "dl.list-works-dl",
      "title": "dt.list-book-dt > a@text",
      "urlRule": "dt.list-book-dt > a@href",
      "cover": "^li img@src",
      "author": "span.book-author a@text",
      "artist": "span.book-boyin a@text",
      "intro": "dd.list-book-des@text"
    },
    "detail": {
      "ua": "mobile",
      "dirUrl": "a.dirurl@href",
      "dirUA": "desktop",
      "episodes": "a[href*=\"/play/\"]",
      "episodeTitle": "@text",
      "episodeUrl": "@href"
    },
    "audio": {
      "type": "post",
      "ua": "desktop",
      "url": "{host}/api/mapi/play",
      "body": "nid={nid}&cid={cid}&sort={sort}",
      "metaFrom": {
        "nid": "_b",
        "cid": "_p",
        "sc": "_c",
        "sort": "_d"
      },
      "metaDefaults": {
        "sort": "read"
      },
      "headers": {
        "sc": "{sc}",
        "Accept": "application/json, text/javascript, */*; q=0.01"
      },
      "sign": {
