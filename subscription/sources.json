[
  {
    "id": "ting15",
    "name": "有听网",
    "host": "https://www.ting15.com",
    "encoding": "utf-8",
    "ua": "desktop",
    "desc": "有听网：有声小说 / 评书 / 相声。搜索、分类、章节、播放全部实测可用（音频走 POST 接口 + Referer 防盗链）。",
    "search": {
      "url": "{host}/?s=ting-search-wd-{kw}.html",
      "pageUrl": "{host}/?s=ting-search-wd-{kw}-p-{page}.html",
      "list": ".category-list ul > li",
      "title": ".info h4 > a@title",
      "urlRule": ".info h4 > a@href",
      "cover": ".img img@src",
      "author": ".info@regex(作者：([^<]*))",
      "artist": ".info@regex(播音：([^<]*))"
    },
    "categories": [
      {
        "title": "武侠玄幻",
        "url": "{host}/wuxiaxuanhuan/",
        "group": "有声小说"
      },
      {
        "title": "恐怖灵异",
        "url": "{host}/kongbulingyi/",
        "group": "有声小说"
      },
      {
        "title": "推理悬疑",
        "url": "{host}/tuilixuanyi/",
        "group": "有声小说"
      },
      {
        "title": "都市言情",
        "url": "{host}/dushiyanqing/",
        "group": "有声小说"
      },
      {
        "title": "家庭伦理",
        "url": "{host}/jiatinglunli/",
        "group": "有声小说"
      },
      {
        "title": "官场职场",
        "url": "{host}/wenxuemingzhu/",
        "group": "有声小说"
      },
      {
        "title": "经典评书",
        "url": "{host}/jingdianpingshu/",
        "group": "评书曲艺"
      },
      {
        "title": "曲艺戏曲",
        "url": "{host}/quyixiqu/",
        "group": "评书曲艺"
      },
      {
        "title": "相声小品",
        "url": "{host}/xiangshengxiaopin/",
        "group": "评书曲艺"
      },
      {
        "title": "助眠音频",
        "url": "{host}/yinyue/",
        "group": "其它"
      }
    ],
    "detail": {
      "episodes": ".playlist .plist ul > li > a",
      "episodeTitle": "@text",
      "episodeUrl": "@href",
      "intro": ".intro p@text",
      "cover": ".bookinfo .bimg img@src",
      "author": ".binfo@regex(作者：([^<]*))",
      "artist": ".binfo@regex(播音：<span class=\"bys\">([^<]*))"
    },
    "audio": {
      "type": "post",
      "url": "{host}/?s=api-getneoplay",
      "metaFrom": {
        "bookId": "_b",
        "isPay": "_p",
        "page": "_cp"
      },
      "body": "bookId={bookId}&isPay={isPay}&page={page}",
      "field": "url",
      "referer": "{host}/"
    }
  },
  {
    "id": "i275",
    "name": "275听书",
    "host": "http://m.i275.com",
    "encoding": "utf-8",
    "warmup": "{host}/",
    "desc": "275听书网（听中国）。没有分类栏目，用搜索找书；播放页需要先访问首页拿 session，本源已做预热。",
    "search": {
      "url": "{host}/search.php?q={kw}",
      "list": "a[href*=/book/]",
      "title": "h3@text",
      "urlRule": "@href",
      "cover": "img@src",
      "artist": "@regex(演播\\s*([^\\s]+))",
      "author": "@regex(作者\\s*([^\\s]+))"
    },
    "detail": {
      "episodes": "a[id*=chapter-pos-]",
      "episodeTitle": "@text",
      "episodeUrl": "@href"
    },
    "audio": {
      "type": "regex",
      "pattern": "url:\\s*\"((?:[^\"\\\\]|\\\\.)*?\\.(?:m4a|mp3)(?:[^\"\\\\]|\\\\.)*)\""
    }
  },
  {
    "id": "pingshu5",
    "name": "单田芳评书网",
    "host": "http://www.pingshu5.net",
    "encoding": "utf-8",
    "searchable": false,
    "desc": "单田芳评书网：全是评书（83 本，含 400 回的白眉大侠）。站方搜索硬限流 3 秒且结果很局限，所以本源只走「书源」页分类浏览；音频是静态直链，零门槛。",
    "search": {
      "url": "{host}/plus/search.php?kwtype=0&q={kw}",
      "list": "div.pop-books2 li",
      "title": "h5.pop-tit@text",
      "urlRule": "a@href",
      "cover": "img@src"
    },
    "categories": [
      {
        "title": "评书",
        "url": "{host}/pbook/",
        "group": "评书"
      },
      {
        "title": "有声书",
        "url": "{host}/ykc/",
        "group": "评书"
      },
      {
        "title": "朗读",
        "url": "{host}/llr/",
        "group": "评书"
      }
    ],
    "detail": {
      "episodes": "div.book-list > ul > li > a",
      "episodeTitle": "@text",
      "episodeUrl": "@href",
      "cover": "img.media-object@src",
      "author": "h3.media-heading@text",
      "intro": "div.book-list@text"
    },
    "audio": {
      "type": "regex",
      "pattern": "<source[^>]+src=\"([^\"]+)\""
    }
  },
  {
    "id": "itingshu",
    "name": "爱听书",
    "host": "https://www.itingshu.net",
    "desc": "爱听书（六千多本）。搜索是 POST 表单；目录要跳 /itingshus/ 且用桌面 UA；音频是签名接口（sc/sp 请求头），被限流会自动换新签名重试。（音频接口有突发限流，会隔 5 秒换新签名重试最多 5 次）",
    "encoding": "utf-8",
    "ua": "mobile",
    "searchable": true,
    "discoverable": false,
    "search": {
      "method": "post",
      "url": "{host}/novelsearch/search/result.html",
      "body": "searchword={kw}",
      "ua": "mobile",
      "list": "dl.list-works-dl",
      "title": "dt.list-book-dt > a@text",
      "urlRule": "dt.list-book-dt > a@href",
      "cover": "^li img@src",
      "author": "span.book-author a@text",
      "artist": "span.book-boyin a@text",
      "intro": "dd.list-book-des@text"
    },
    "detail": {
      "ua": "mobile",
      "dirUrl": "a.dirurl@href",
      "dirUA": "desktop",
      "episodes": "a[href*=\"/play/\"]",
      "episodeTitle": "@text",
      "episodeUrl": "@href"
    },
    "audio": {
      "type": "post",
      "ua": "desktop",
      "url": "{host}/api/mapi/play",
      "body": "nid={nid}&cid={cid}&sort={sort}",
      "metaFrom": {
        "nid": "_b",
        "cid": "_p",
        "sc": "_c",
        "sort": "_d"
      },
      "metaDefaults": {
        "sort": "read"
      },
      "headers": {
        "sc": "{sc}",
        "Accept": "application/json, text/javascript, */*; q=0.01"
      },
      "sign": {
        "kind": "ptcmsSp",
        "input": "{sc}",
        "header": "sp"
      },
      "field": "url",
      "statusField": "status",
      "statusOK": "200",
      "retries": 5,
      "replace": [
        [
          "https://mp3pd.",
          "http://mp3pd."
        ]
      ],
      "referer": "{episodeUrl}",
      "retryDelayMs": 5000
    }
  },
  {
